# Formspree - for receiving form submissions via email
# Sign up at https://formspree.io, create a form, and paste the ID here
# Example: if your endpoint is https://formspree.io/f/xyzabcde then the ID is xyzabcde
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID

# Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=

# Site URL
NEXT_PUBLIC_SITE_URL=https://thebucketlist.co

# Admin API key for accessing local enquiries backup
ADMIN_API_KEY=your-secret-admin-key-here
